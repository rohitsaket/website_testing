{
  "name": "wte-platform",
  "version": "0.1.0",
  "description": "WTE — Enterprise Autonomous Quality Engineering & Testing Platform (Phase 1: Foundation)",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:only": "node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "node dist/src/cli.js scan",
    "serve": "node dist/src/cli.js serve",
    "wte": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2"
  }
}
